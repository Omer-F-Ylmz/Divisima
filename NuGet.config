<?xml version="1.0" encoding="utf-8"?>
<!-- GF-4/K4 (Y5) - TEDARIK ZINCIRI: paket kaynagi TEK ve ACIKCA yazili.
     Zeminde bu dosya YOKTU; restore MAKINE duzeyi kaynaklari kullaniyordu ve
     olculdu ki ikinci bir kaynak etkindi:
       "Microsoft Visual Studio Offline Packages" -> C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\
     Yani ayni ada sahip bir paketin nereden gelecegi MAKINEYE bagliydi (kaynak
     karisikligi / source confusion yuzeyi). <clear /> devralinan tum kaynaklari
     dusurur, altindaki tek satir gecerli kalir. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
