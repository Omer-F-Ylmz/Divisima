<Project>
  <!-- Aciklayici yorum: Tum projelere uygulanan ortak ayarlar (kod kalitesi zorlamasi). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- .NET analizorleri: guvenlik + kalite kurallari acik -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- Uyarilari raporla; CI'da -warnaserror ile bloklanabilir -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Deterministik build (reproducible) -->
    <Deterministic>true</Deterministic>
    <!-- GF-4/K4 (Y5) - TEDARIK ZINCIRI: her proje packages.lock.json uretir ve o dosya
         depoya girer. Boylece cozumlenen GECISLI graf de surum kontrolunde olur; CI
         restore adimi "locked-mode" bayragiyla grafin degismedigini DOGRULAR (sessiz
         gecisli surum kaymasi biter). Lock dosyasi degistiginde diff'te GORUNUR.
         NOT: bu yorumda cift tire KULLANILAMAZ (XML kurali) - bayrak adi bu yuzden
         duz yazildi; bir kez bozuk XML uretildi ve "dotnet restore" buna ragmen
         exit 0 verdi, hatayi yalniz "msbuild -getProperty" probu gosterdi. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- GF-4/K7 - NuGet denetimi GECISLI paketleri de kapsar. Varsayilan "direct" YALNIZ
         dogrudan basvurulari tarar; oysa bu cozumdeki acik paketlerin cogu GECISLIDIR
         (olculdu: SSH.NET, System.Net.Http, System.Text.RegularExpressions dogrudan
         basvurulmuyor). Deger ACIKCA yaziliyor cunku varsayilan TFM SURUMUNE baglidir:
         SDK 9'un NuGet.targets:76-79 kosulu "TargetFrameworkVersion >= 10.0 ise all, aksi
         halde direct" der (OLCULDU, kaynak SDK dosyasindan okundu). TFM net8.0 oldugu
         surece varsayilan "direct"tir.
         GF-5 DUZELTMESI (GF-4'un 7. CC hatasi): onceki metin "varsayilan SDK SURUMUNE
         baglidir ... olculdu, bugun ikisi de direct" diyordu. Ikisi de yanlisti. (a) Kosul
         SDK surumune degil TFM surumune bakiyor. (b) CI (SDK 8) tarafi BU MAKINEDE
         OLCULEMEZ: kurulu tek SDK 9.0.305 ("dotnet" SDK listesi ile olculdu) ve global.json
         YOK; o taraf
         icin "direct" bir CIKARIMDIR, olcum degil. Sonuc yine "direct" cikar (TFM net8.0
         sabit) ama GEREKCE ve KANIT TURU duzeltildi.
         UYARI SEVIYESI, HATA DEGIL: depoda -warnaserror / TreatWarningsAsErrors YOK
         (olculdu), dolayisiyla NU1901-NU1904 build'i KIRMAZ. Kapi gorevini security.yml'
         daki dependency-scan (advisory-id allowlist'li) gormeye devam eder; burasi
         GORUNURLUK saglar. -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
